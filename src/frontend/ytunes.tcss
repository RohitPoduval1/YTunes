/* Center the main wrapper in the dead middle of the terminal */
Screen {
    align: center middle;
    background: #121212; /* Optional: Nice dark background */
}

/* The wrapper controls the overall size and keeps everything stacked cleanly */
#main_wrapper {
    width: 60; 
    height: auto;
}

/* Logo sits perfectly in the wrapper */
#logo {
    content-align: center middle;
    text-style: bold;
    color: #ff0000;
    margin-bottom: 2;
    width: 100%;
}

/* List takes up the full width of the wrapper */
#main_playlist_list {
    width: 100%; 
    height: auto;
    max-height: 15;
    border: solid #ff0000; /* Moves your red border to the outside of the list */
    background: #1e1e1e;
}

ListView {
    width: 30;
    height: auto;
    margin: 2 2;
}

Label {
    padding: 1 2;
}
